{
  "name": "opencode-scheduler",
  "version": "2.0.0-alpha.0",
  "description": "OpenCode plugin for scheduling recurring jobs using launchd, systemd, Task Scheduler, or cron fallback",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "type": "module",
  "files": [
    "dist",
    "src",
    "server.ts"
  ],
  "exports": {
    "./server": "./server.ts",
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "bun build src/plugin.ts --outdir dist --target bun --format esm --external @opencode/plugin --external effect && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "scheduler",
    "cron",
    "launchd",
    "systemd",
    "automation",
    "jobs"
  ],
  "author": "Benjamin Shafii",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/different-ai/opencode-scheduler.git"
  },
  "bugs": {
    "url": "https://github.com/different-ai/opencode-scheduler/issues"
  },
  "homepage": "https://github.com/different-ai/opencode-scheduler#readme",
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.26",
    "bun-types": "1.3.10",
    "typescript": "^5.7.3"
  }
}
